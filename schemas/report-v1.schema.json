{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concurtest.dev/schemas/report-v1.schema.json",
  "title": "ConcurTest JSON report 1.0.0",
  "oneOf": [
    { "$ref": "#/$defs/run_report" },
    { "$ref": "#/$defs/error_report" }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "causes"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "message": { "type": "string" },
        "causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/error" }
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "completed_at", "duration_ns"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "duration_ns": { "type": "integer", "minimum": 0 }
      }
    },
    "nullable_timing": {
      "oneOf": [
        { "$ref": "#/$defs/timing" },
        { "type": "null" }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "target"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 }
      }
    },
    "json_integer_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "path"],
      "properties": {
        "type": { "const": "json_integer" },
        "name": { "type": "string", "minLength": 1 },
        "path": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "minimum": { "type": "integer" },
        "maximum": { "type": "integer" },
        "equals": { "type": "integer" },
        "change": { "type": "integer" }
      },
      "oneOf": [
        { "required": ["change"], "not": { "anyOf": [{ "required": ["minimum"] }, { "required": ["maximum"] }, { "required": ["equals"] }] } },
        { "required": ["equals"], "not": { "anyOf": [{ "required": ["minimum"] }, { "required": ["maximum"] }, { "required": ["change"] }] } },
        { "anyOf": [{ "required": ["minimum"] }, { "required": ["maximum"] }], "not": { "anyOf": [{ "required": ["equals"] }, { "required": ["change"] }] } }
      ]
    },
    "maximum_successful_attempts_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "maximum", "successful_status_codes"],
      "properties": {
        "type": { "const": "maximum_successful_attempts" },
        "name": { "type": "string", "minLength": 1 },
        "maximum": { "type": "integer", "minimum": 0 },
        "successful_status_codes": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 100, "maximum": 599 }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "invariant_definition": {
      "oneOf": [
        { "$ref": "#/$defs/json_integer_definition" },
        { "$ref": "#/$defs/maximum_successful_attempts_definition" }
      ]
    },
    "outcome_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted_status_codes", "rejected_status_codes", "minimum_accepted_attempts"],
      "properties": {
        "accepted_status_codes": {
          "oneOf": [
            { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 100, "maximum": 599 } },
            { "type": "null" }
          ]
        },
        "rejected_status_codes": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 100, "maximum": 599 } },
        "minimum_accepted_attempts": { "type": "integer", "minimum": 0 }
      }
    },
    "outcome_evaluation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["accepted_attempt_ids", "rejected_attempt_ids", "unexpected_attempt_ids", "unknown_attempt_ids", "minimum_accepted_attempts", "requirements_met"],
          "properties": {
            "accepted_attempt_ids": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
            "rejected_attempt_ids": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
            "unexpected_attempt_ids": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
            "unknown_attempt_ids": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
            "minimum_accepted_attempts": { "type": "integer", "minimum": 0 },
            "requirements_met": { "type": "boolean" }
          }
        },
        { "type": "null" }
      ]
    },
    "assertion_definition": {
      "oneOf": [
        { "allOf": [{ "$ref": "#/$defs/json_integer_definition" }, { "not": { "required": ["change"] } }] },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "path", "equals"],
          "properties": {
            "type": { "const": "json_boolean" },
            "name": { "type": "string", "minLength": 1 },
            "path": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "equals": { "type": "boolean" }
          }
        }
      ]
    },
    "nullable_assertion_definition": {
      "oneOf": [{ "$ref": "#/$defs/assertion_definition" }, { "type": "null" }]
    },
    "assertion_evaluation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "observed", "satisfied"],
          "properties": {
            "type": { "enum": ["json_integer", "json_boolean"] },
            "observed": {},
            "satisfied": { "type": "boolean" }
          },
          "allOf": [
            { "if": { "properties": { "type": { "const": "json_integer" } } }, "then": { "properties": { "observed": { "type": ["integer", "null"] } } }, "else": { "properties": { "observed": { "type": ["boolean", "null"] } } } },
            { "if": { "properties": { "satisfied": { "const": true } } }, "then": { "properties": { "observed": { "not": { "type": "null" } } } } }
          ]
        },
        { "type": "null" }
      ]
    },
    "precondition_definition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["request", "assertion"],
          "properties": {
            "request": { "$ref": "#/$defs/request" },
            "assertion": { "$ref": "#/$defs/assertion_definition" }
          }
        },
        { "type": "null" }
      ]
    },
    "precondition_execution": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["execution", "assertion"],
          "properties": {
            "execution": { "$ref": "#/$defs/execution" },
            "assertion": { "$ref": "#/$defs/assertion_evaluation" }
          }
        },
        { "type": "null" }
      ]
    },
    "wait_definition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["request", "assertion", "timeout_ns", "interval_ns", "max_polls"],
          "properties": {
            "request": { "$ref": "#/$defs/request" },
            "assertion": { "$ref": "#/$defs/assertion_definition" },
            "timeout_ns": { "type": "integer", "minimum": 1 },
            "interval_ns": { "type": "integer", "minimum": 1 },
            "max_polls": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        { "type": "null" }
      ]
    },
    "wait_execution": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["timing", "polls", "satisfied", "error"],
          "properties": {
            "timing": { "$ref": "#/$defs/nullable_timing" },
            "satisfied": { "type": "boolean" },
            "error": { "oneOf": [{ "$ref": "#/$defs/error" }, { "type": "null" }] },
            "polls": {
              "type": "array", "maxItems": 100,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["number", "execution", "assertion"],
                "properties": {
                  "number": { "type": "integer", "minimum": 1, "maximum": 100 },
                  "execution": { "$ref": "#/$defs/execution" },
                  "assertion": { "$ref": "#/$defs/assertion_evaluation" }
                }
              }
            }
          }
        },
        { "type": "null" }
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "name", "target", "request_timeout_ns", "execution", "setup", "precondition", "readiness", "completion", "operation", "observation", "invariant", "outcomes"],
      "properties": {
        "readiness": { "$ref": "#/$defs/wait_definition" },
        "completion": { "$ref": "#/$defs/wait_definition" },
        "precondition": { "$ref": "#/$defs/precondition_definition" },
        "outcomes": { "$ref": "#/$defs/outcome_policy" },
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "target": { "type": "string" },
        "request_timeout_ns": { "type": "integer", "minimum": 0 },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attempts", "concurrency", "trials", "reduction_enabled"],
          "properties": {
            "attempts": { "type": "integer", "minimum": 1 },
            "concurrency": { "type": "integer", "minimum": 1 },
            "trials": { "type": "integer", "minimum": 1, "maximum": 100 },
            "reduction_enabled": { "type": "boolean" }
          }
        },
        "setup": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "request", "assertion"],
            "properties": {
              "assertion": { "$ref": "#/$defs/nullable_assertion_definition" },
              "name": { "type": "string" },
              "request": { "$ref": "#/$defs/request" }
            }
          }
        },
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "request"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "request": { "$ref": "#/$defs/request" }
          }
        },
        "observation": {
          "oneOf": [
            { "$ref": "#/$defs/request" },
            { "type": "null" }
          ]
        },
        "invariant": { "$ref": "#/$defs/invariant_definition" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "completed", "passed", "violated", "inconclusive", "errored", "first_violation_trial", "timing"],
      "properties": {
        "requested": { "type": "integer", "minimum": 0, "maximum": 100 },
        "completed": { "type": "integer", "minimum": 0, "maximum": 100 },
        "passed": { "type": "integer", "minimum": 0, "maximum": 100 },
        "violated": { "type": "integer", "minimum": 0, "maximum": 100 },
        "inconclusive": { "type": "integer", "minimum": 0, "maximum": 100 },
        "errored": { "type": "integer", "minimum": 0, "maximum": 100 },
        "first_violation_trial": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100
        },
        "timing": { "$ref": "#/$defs/nullable_timing" }
      }
    },
    "response_excerpt": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["encoding", "data", "retained_bytes", "truncated"],
          "properties": {
            "encoding": { "const": "utf-8" },
            "data": { "type": "string" },
            "retained_bytes": { "type": "integer", "minimum": 0, "maximum": 512 },
            "truncated": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["encoding", "data", "retained_bytes", "truncated"],
          "properties": {
            "encoding": { "const": "base64" },
            "data": { "type": "string", "contentEncoding": "base64" },
            "retained_bytes": { "type": "integer", "minimum": 0, "maximum": 512 },
            "truncated": { "type": "boolean" }
          }
        }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status_code", "body_excerpt"],
      "properties": {
        "status_code": { "type": "integer", "minimum": 0, "maximum": 999 },
        "body_excerpt": {
          "oneOf": [
            { "$ref": "#/$defs/response_excerpt" },
            { "type": "null" }
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "response", "timing", "error", "request_writes"],
      "properties": {
        "request_writes": { "type": "integer", "minimum": 0 },
        "request": { "$ref": "#/$defs/request" },
        "response": {
          "oneOf": [
            { "$ref": "#/$defs/response" },
            { "type": "null" }
          ]
        },
        "timing": { "$ref": "#/$defs/nullable_timing" },
        "error": {
          "oneOf": [
            { "$ref": "#/$defs/error" },
            { "type": "null" }
          ]
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation_name", "start_offset_ns", "execution"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "operation_name": { "type": "string" },
        "start_offset_ns": { "type": ["integer", "null"], "minimum": 0 },
        "execution": {
          "oneOf": [
            { "$ref": "#/$defs/execution" },
            { "type": "null" }
          ]
        }
      }
    },
    "json_integer_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "observed", "violated"],
      "properties": {
        "type": { "const": "json_integer" },
        "observed": { "type": "integer" },
        "baseline": { "type": "integer" },
        "change": { "type": "integer" },
        "violated": { "type": "boolean" }
      },
      "dependentRequired": { "baseline": ["change"], "change": ["baseline"] }
    },
    "maximum_successful_attempts_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "successful_attempt_ids", "over_limit_attempt_ids", "violated"],
      "properties": {
        "type": { "const": "maximum_successful_attempts" },
        "successful_attempt_ids": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "over_limit_attempt_ids": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "violated": { "type": "boolean" }
      }
    },
    "invariant_evaluation": {
      "oneOf": [
        { "$ref": "#/$defs/json_integer_evaluation" },
        { "$ref": "#/$defs/maximum_successful_attempts_evaluation" },
        { "type": "null" }
      ]
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "status", "error", "evidence"],
      "properties": {
        "number": { "type": "integer", "minimum": 1, "maximum": 100 },
        "status": { "enum": ["passed", "violated", "inconclusive", "errored"] },
        "error": {
          "oneOf": [
            { "$ref": "#/$defs/error" },
            { "type": "null" }
          ]
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "timing", "setup", "precondition", "readiness", "completion", "history", "baseline_observation", "observation", "invariant_evaluation", "outcome_evaluation"],
          "properties": {
            "readiness": { "$ref": "#/$defs/wait_execution" },
            "completion": { "$ref": "#/$defs/wait_execution" },
            "precondition": { "$ref": "#/$defs/precondition_execution" },
            "outcome_evaluation": { "$ref": "#/$defs/outcome_evaluation" },
            "outcome": { "type": ["string", "null"], "enum": ["passed", "violated", "inconclusive", null] },
            "timing": { "$ref": "#/$defs/nullable_timing" },
            "setup": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "execution", "assertion"],
                "properties": {
                  "assertion": { "$ref": "#/$defs/assertion_evaluation" },
                  "name": { "type": "string" },
                  "execution": { "$ref": "#/$defs/execution" }
                }
              }
            },
            "history": {
              "type": "object",
              "additionalProperties": false,
              "required": ["timing", "attempts"],
              "properties": {
                "timing": { "$ref": "#/$defs/nullable_timing" },
                "attempts": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/attempt" }
                }
              }
            },
            "baseline_observation": {
              "oneOf": [
                { "$ref": "#/$defs/execution" },
                { "type": "null" }
              ]
            },
            "observation": {
              "oneOf": [
                { "$ref": "#/$defs/execution" },
                { "type": "null" }
              ]
            },
            "invariant_evaluation": { "$ref": "#/$defs/invariant_evaluation" }
          }
        }
      }
    },
    "baseline_reduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempts", "concurrency", "summary"],
      "properties": {
        "attempts": { "type": "integer", "minimum": 1 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "summary": { "$ref": "#/$defs/summary" }
      }
    },
    "candidate_reduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "attempts", "concurrency", "accepted", "summary", "error", "trials", "outcome_requirements_met", "matching_violations"],
      "properties": {
        "outcome_requirements_met": { "type": "boolean" },
        "matching_violations": { "type": "integer", "minimum": 0, "maximum": 100 },
        "number": { "type": "integer", "minimum": 1, "maximum": 100 },
        "attempts": { "type": "integer", "minimum": 1 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "accepted": { "type": "boolean" },
        "summary": { "$ref": "#/$defs/candidate_summary" },
        "error": {
          "oneOf": [
            { "$ref": "#/$defs/error" },
            { "type": "null" }
          ]
        },
        "trials": {
          "oneOf": [
            {
              "type": "array",
              "items": { "$ref": "#/$defs/trial" }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "candidate_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "completed", "passed", "violated", "inconclusive", "errored", "timing"],
      "properties": {
        "requested": { "type": "integer", "minimum": 0, "maximum": 100 },
        "completed": { "type": "integer", "minimum": 0, "maximum": 100 },
        "passed": { "type": "integer", "minimum": 0, "maximum": 100 },
        "violated": { "type": "integer", "minimum": 0, "maximum": 100 },
        "inconclusive": { "type": "integer", "minimum": 0, "maximum": 100 },
        "errored": { "type": "integer", "minimum": 0, "maximum": 100 },
        "timing": { "$ref": "#/$defs/nullable_timing" }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "candidate_number", "attempts", "concurrency"],
      "properties": {
        "source": { "enum": ["baseline", "candidate"] },
        "candidate_number": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
        "attempts": { "type": "integer", "minimum": 1 },
        "concurrency": { "type": "integer", "minimum": 1 }
      }
    },
    "reduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "timing", "max_candidates", "baseline", "candidates", "selection", "failure_direction"],
      "properties": {
        "status": { "enum": ["skipped", "reduced", "unchanged", "limited", "stopped", "interrupted", "errored"] },
        "failure_direction": { "enum": ["below", "above", null] },
        "timing": { "$ref": "#/$defs/nullable_timing" },
        "max_candidates": { "type": "integer", "minimum": 1 },
        "baseline": { "$ref": "#/$defs/baseline_reduction" },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/candidate_reduction" }
        },
        "selection": {
          "oneOf": [
            { "$ref": "#/$defs/selection" },
            { "type": "null" }
          ]
        }
      }
    },
    "run_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "report_type", "status", "scenario", "summary", "trials", "reduction", "error", "reproduction"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "report_type": { "const": "run" },
        "status": { "enum": ["passed", "violated", "inconclusive", "errored", "interrupted"] },
        "scenario": { "$ref": "#/$defs/scenario" },
        "summary": { "$ref": "#/$defs/summary" },
        "trials": {
          "type": "array",
          "items": { "$ref": "#/$defs/trial" }
        },
        "reduction": {
          "oneOf": [
            { "$ref": "#/$defs/reduction" },
            { "type": "null" }
          ]
        },
        "error": {
          "oneOf": [
            { "$ref": "#/$defs/error" },
            { "type": "null" }
          ]
        },
        "reproduction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["arguments"],
          "properties": {
            "arguments": {
              "type": "array",
              "minItems": 4,
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "error_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "report_type", "status", "context", "error"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "report_type": { "const": "error" },
        "status": { "const": "errored" },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scenario_path", "scenario_name", "target"],
          "properties": {
            "scenario_path": { "type": ["string", "null"] },
            "scenario_name": { "type": ["string", "null"] },
            "target": { "type": ["string", "null"] }
          }
        },
        "error": { "$ref": "#/$defs/error" }
      }
    }
  }
}
